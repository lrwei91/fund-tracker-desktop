{
  "name": "fund-tracker-desktop",
  "version": "1.0.3",
  "description": "恭喜发财本地 Tauri 桌面应用",
  "private": true,
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "start": "npm run frontend:prepare && tauri dev",
    "frontend:prepare": "node scripts/prepare-tauri-frontend.js",
    "check": "node --check app/config-schema.js && node --check app/theme.js && node --check app/tauri-shell.js && node scripts/check-js.js && node scripts/check-rust.js",
    "smoke": "node scripts/smoke-watchlist.js",
    "smoke:refresh": "vitest run test/refresh-coordinator.test.js",
    "smoke:data": "cargo test --manifest-path src-tauri/Cargo.toml live_data_smoke -- --nocapture",
    "icons:generate": "node scripts/generate-icons.js",
    "version:bump": "node scripts/bump-version.js",
    "build:mac": "npm run build:mac:raw",
    "build:win": "npm run build:win:raw",
    "build:all": "npm run build:mac:raw && npm run build:win:raw",
    "build:mac:raw": "npm run frontend:prepare && tauri build --bundles app && node scripts/package-tauri.js mac",
    "build:win:raw": "npm run frontend:prepare && tauri build --no-bundle && node scripts/package-tauri.js win",
    "size:check": "node scripts/check-artifact-size.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"app/**/*.js\" \"renderer/**/*.js\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "wrangler dev --config services/fund-intraday-collector/wrangler.toml",
    "worker:test": "vitest run test/fund-intraday-collector.test.js",
    "worker:deploy:dry": "wrangler deploy --dry-run --config services/fund-intraday-collector/wrangler.toml",
    "artifact:verify": "node scripts/check-artifact-size.js --verify"
  },
  "overrides": {
    "form-data": "^4.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.8.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
