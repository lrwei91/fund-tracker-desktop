{
  "name": "fund-tracker-electron",
  "version": "0.1.19",
  "description": "恭喜发财本地 Electron 桌面应用",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && for f in renderer/*.js app/app.js app/api/*.js app/modules/*.js app/modules/watchlist/*.js; do node --check \"$f\"; done",
    "smoke": "node scripts/smoke-watchlist.js",
    "version:bump": "node scripts/bump-version.js",
    "build:mac": "npm run version:bump && npm run build:mac:raw",
    "build:win": "npm run version:bump && npm run build:win:raw",
    "build:win:arm64": "npm run version:bump && npm run build:win:arm64:raw",
    "build:all": "npm run version:bump && npm run build:mac:raw && npm run build:win:raw",
    "build:mac:raw": "electron-builder --mac",
    "build:win:raw": "electron-builder --win --x64",
    "build:win:arm64:raw": "electron-builder --win --arm64",
    "lint": "eslint .",
    "format": "prettier --write \"app/**/*.js\" \"renderer/**/*.js\" main.js preload.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.4",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.local.fundtracker",
    "productName": "恭喜发财",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.finance"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "app/**/*"
    ]
  }
}
